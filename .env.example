# ==========================================
# BLYc Environment Configuration Example
# Copy this file to .env before starting services
# NEVER commit the actual .env file with secrets
# ==========================================

# Server / API Layer (Node.js)
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Security & JWT
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_secure_cookie_signing_secret

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/blyc_db?retryWrites=true&ww=majority

# Python Analytics Engine Service (Internal)
PYTHON_ENGINE_URL=http://127.0.0.1:8001

# AI Interpretation Layer (Groq API)
# Model fixed: openai/gpt-oss-20b
GROQ_API_KEY=gsk_your_groq_api_key_here
